diff --git a/packages/app-lib/src/api/settings.rs b/packages/app-lib/src/api/settings.rs
index 08d2321..7bacce6 100644
--- a/packages/app-lib/src/api/settings.rs
+++ b/packages/app-lib/src/api/settings.rs
@@ -5,6 +5,98 @@ pub use crate::{
     State,
     state::{Hooks, MemorySettings, Settings, WindowSize},
 };
+use std::path::{Path, PathBuf};
+
+fn astralrinth_settings_dir() -> Option<PathBuf> {
+    Some(dirs::data_dir()?.join("AstralRinthApp"))
+}
+
+fn astralrinth_is_present() -> bool {
+    let Some(root) = astralrinth_settings_dir() else {
+        return false;
+    };
+    root.join("settings.json").is_file()
+        || root.join("profiles").is_dir()
+        || root.join("app.db").is_file()
+}
+
+pub async fn astralrinth_status() -> crate::Result<bool> {
+    Ok(astralrinth_is_present())
+}
+
+pub async fn port_astralrinth_instances() -> crate::Result<usize> {
+    let state = State::get().await?;
+    let Some(root) = astralrinth_settings_dir() else {
+        return Ok(0);
+    };
+    if !astralrinth_is_present() {
+        return Ok(0);
+    }
+
+    let source_profiles = astralrinth_custom_dir(&root)
+        .unwrap_or_else(|| root.clone())
+        .join("profiles");
+    if source_profiles.is_dir() {
+        let destination_profiles = state.directories.config_dir.join("profiles");
+        tokio::fs::create_dir_all(&destination_profiles).await?;
+        copy_directory_contents(&source_profiles, &destination_profiles).await?;
+    }
+
+    let count = crate::state::legacy_converter::migrate_legacy_data_from(
+        &root,
+        &state.pool,
+        false,
+    )
+    .await?;
+    Ok(count)
+}
+
+async fn copy_directory_contents(source: &Path, destination: &Path) -> crate::Result<()> {
+    let mut entries = tokio::fs::read_dir(source).await?;
+    while let Some(entry) = entries.next_entry().await? {
+        let source_path = entry.path();
+        let destination_path = destination.join(entry.file_name());
+        if source_path.is_dir() {
+            tokio::fs::create_dir_all(&destination_path).await?;
+            copy_directory_contents(&source_path, &destination_path).await?;
+        } else if source_path.is_file()
+            && !destination_path.exists()
+        {
+            tokio::fs::copy(&source_path, &destination_path).await?;
+        }
+    }
+    Ok(())
+}
+
+fn astralrinth_custom_dir(root: &Path) -> Option<PathBuf> {
+    let settings: serde_json::Value =
+        serde_json::from_slice(&std::fs::read(root.join("settings.json")).ok()?)
+            .ok()?;
+    let path = settings.get("loaded_config_dir")?.as_str()?;
+    let path = PathBuf::from(path);
+    if path == root {
+        return None;
+    }
+    path.join("profiles").is_dir().then_some(path)
+}
+
+pub async fn remove_astralrinth() -> crate::Result<()> {
+    let Some(root) = astralrinth_settings_dir() else {
+        return Ok(());
+    };
+    let custom_dir = astralrinth_custom_dir(&root);
+
+    if root.is_dir() {
+        tokio::fs::remove_dir_all(&root).await?;
+    }
+    if let Some(custom_dir) = custom_dir {
+        let profiles_dir = custom_dir.join("profiles");
+        if profiles_dir.is_dir() {
+            tokio::fs::remove_dir_all(profiles_dir).await?;
+        }
+    }
+    Ok(())
+}
 
