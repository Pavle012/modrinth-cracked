diff --git a/apps/app-frontend/src/components/ui/astralrinth/AstralRinthMigrationModal.vue b/apps/app-frontend/src/components/ui/astralrinth/AstralRinthMigrationModal.vue
new file mode 100644
index 0000000..7af1f1d
--- /dev/null
+++ b/apps/app-frontend/src/components/ui/astralrinth/AstralRinthMigrationModal.vue
@@ -0,0 +1,65 @@
+<script setup lang="ts">
+import { ConfirmModal } from '@modrinth/ui'
+import { ref } from 'vue'
+import type { InstanceType } from 'vue'
+
+import {
+	astralrinthStatus,
+	portAstralRinthInstances,
+	removeAstralRinth,
+} from '@/helpers/settings.ts'
+
+const modal = ref<InstanceType<typeof ConfirmModal> | null>(null)
+const removeModal = ref<InstanceType<typeof ConfirmModal> | null>(null)
+const porting = ref(false)
+const removing = ref(false)
+const portedCount = ref(0)
+
+async function run() {
+	if (!(await astralrinthStatus())) return false
+	modal.value?.show()
+	return true
+}
+
+async function port() {
+	porting.value = true
+	try {
+		portedCount.value = await portAstralRinthInstances()
+		removeModal.value?.show()
+	} finally {
+		porting.value = false
+	}
+}
+
+async function remove() {
+	removing.value = true
+	try {
+		await removeAstralRinth()
+		removeModal.value?.hide()
+	} finally {
+		removing.value = false
+	}
+}
+
+defineExpose({ run })
+</script>
+
+<template>
+	<ConfirmModal
+		ref="modal"
+		title="Import instances from AstralRinth?"
+		description="AstralRinth was detected on this device. Import all of its instances, settings, accounts, and world data into this launcher?"
+		proceed-label="Import"
+		:show-ad-on-close="false"
+		@proceed="port"
+	/>
+	<ConfirmModal
+		ref="removeModal"
+		title="Remove AstralRinth?"
+		:description="`AstralRinth import is finished (${portedCount} instances ported). Remove AstralRinth and all of its local app data?`"
+		proceed-label="Remove AstralRinth"
+		danger
+		:show-ad-on-close="false"
+		@proceed="remove"
+	/>
+</template>
