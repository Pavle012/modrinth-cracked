@@ -0,0 +1,150 @@
+//! Helpers for offline accounts: accounts that are not backed by a Microsoft
+//! login and can only be used on offline-mode servers, LAN and singleplayer.
+//!
+//! Self-contained on purpose (no extra dependencies) so the patch that adds
+//! offline accounts stays small and easy to carry across upstream releases.
+
+use uuid::Uuid;
+
+/// Marker stored in the `refresh_token` column for offline accounts. Real
+/// Microsoft refresh tokens never look like this, and storing the marker in an
+/// existing column means no database migration is needed (so the database
+/// stays compatible with the official app).
+pub const OFFLINE_REFRESH_TOKEN: &str = "offline-account";
+
+/// Dummy access token handed to the game for offline accounts.
+pub const OFFLINE_ACCESS_TOKEN: &str = "0";
+
+pub const MIN_USERNAME_LEN: usize = 3;
+pub const MAX_USERNAME_LEN: usize = 16;
+
+/// Whether `username` is acceptable as an offline player name
+/// (3-16 characters, ASCII letters, digits and underscores).
+pub fn is_valid_username(username: &str) -> bool {
+    (MIN_USERNAME_LEN..=MAX_USERNAME_LEN).contains(&username.len())
+        && username
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b == b'_')
+}
+
+/// The UUID vanilla offline-mode servers assign to `username`, i.e. Java's
+/// `UUID.nameUUIDFromBytes("OfflinePlayer:<name>".getBytes(UTF_8))`.
+pub fn offline_uuid(username: &str) -> Uuid {
+    let mut hash = md5(format!("OfflinePlayer:{username}").as_bytes());
+    hash[6] = (hash[6] & 0x0f) | 0x30; // version 3
+    hash[8] = (hash[8] & 0x3f) | 0x80; // IETF variant
+    Uuid::from_bytes(hash)
+}
