+impl Credentials {
+    /// Whether this is an offline account (no Microsoft login behind it).
+    pub fn is_offline_account(&self) -> bool {
+        self.refresh_token
+            == crate::util::offline_account::OFFLINE_REFRESH_TOKEN
+    }
+
+    /// Creates an active offline account for `username`, using the same UUID
+    /// vanilla offline-mode servers derive from the name.
+    pub fn new_offline(username: &str) -> crate::Result<Self> {
+        use crate::util::offline_account::{
+            OFFLINE_ACCESS_TOKEN, OFFLINE_REFRESH_TOKEN, is_valid_username,
+            offline_uuid,
+        };
+
+        let username = username.trim();
+        if !is_valid_username(username) {
+            anyhow::bail!(ErrorKind::InputError(
+                "Offline usernames must be 3-16 characters long and only contain letters, numbers and underscores"
+                    .to_string()
+            ));
+        }
+
+        Ok(Self {
+            offline_profile: MinecraftProfile {
+                id: offline_uuid(username),
+                name: username.to_string(),
+                ..MinecraftProfile::default()
+            },
+            access_token: OFFLINE_ACCESS_TOKEN.to_string(),
+            refresh_token: OFFLINE_REFRESH_TOKEN.to_string(),
+            // Never expires; far enough in the future to fit the DB timestamp
+            expires: Utc::now() + Duration::days(365 * 100),
+            active: true,
+        })
+    }
+
+    /// Fails for offline accounts; used by features that need Mojang's APIs.
+    pub fn ensure_online_account(&self) -> crate::Result<()> {
+        if self.is_offline_account() {
+            anyhow::bail!(ErrorKind::InputError(
+                "This is not available for offline accounts".to_string()
+            ));
+        }
+        Ok(())
+    }
+}
