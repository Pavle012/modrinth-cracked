+/// Adds an offline account (no Microsoft login) and makes it the active one.
+/// Offline accounts only work on offline-mode servers, LAN and singleplayer.
+#[tracing::instrument]
+pub async fn add_offline_user(username: &str) -> crate::Result<Credentials> {
+    let state = State::get().await?;
+
+    let credentials = Credentials::new_offline(username)?;
+    credentials.upsert(&state.pool).await?;
+
+    if let Err(error) =
+        crate::onboarding_checklist::mark_logged_into_minecraft().await
+    {
+        tracing::warn!(
+            "Failed to mark Minecraft login in onboarding checklist: {error}"
+        );
+    }
+
+    Ok(credentials)
+}
