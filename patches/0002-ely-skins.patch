@@ -0,0 +1,275 @@
+<template>
+	<NewModal ref="modal" header="Ely.by skins" max-width="640px">
+		<div class="flex flex-col gap-4">
+			<p class="m-0 text-primary">
+				Offline accounts keep their skin on Ely.by, under the same username (<b>{{
+					username
+				}}</b
+				>). Sign in to Ely.by once with the button below, then pick or upload a skin here.
+			</p>
+			<p class="m-0 text-sm text-secondary">
+				This does not change what the game shows by itself. To see the skin in-game, install the
+				CustomSkinLoader mod and enable its Ely.by skin source.
+			</p>
+
+			<div v-if="loading" class="flex items-center gap-2 text-secondary">
+				<SpinnerIcon class="animate-spin" /> Loading skins...
+			</div>
+			<p v-else-if="loadError" class="m-0 text-red">{{ loadError }}</p>
+			<p v-else-if="!tiles.length" class="m-0 text-secondary">
+				No skins found for {{ username }} on Ely.by. Upload one below.
+			</p>
+
+			<div v-if="tiles.length" class="grid grid-cols-[repeat(auto-fill,minmax(96px,1fr))] gap-3">
+				<button
+					v-for="tile in tiles"
+					:key="tile.key"
+					type="button"
+					class="flex flex-col items-center gap-2 rounded-xl border-2 border-solid bg-surface-4 p-3 text-primary"
+					:class="selectedKey === tile.key ? 'border-brand' : 'border-transparent'"
+					:disabled="busy"
+					@click="selectedKey = tile.key"
+				>
+					<div
+						class="h-16 w-16 rounded-lg bg-surface-5"
+						:style="headStyle(textures[tile.url])"
+						role="img"
+						:aria-label="tile.label"
+					/>
+					<span class="text-xs">{{ tile.label }}</span>
+					<span v-if="tile.current" class="text-xs font-semibold text-brand">In use</span>
+				</button>
+			</div>
+
+			<div class="flex flex-wrap gap-2">
+				<Button :disabled="busy" @click="fileInput?.click()">
+					<UploadIcon /> Upload skin (PNG)
+				</Button>
+				<Button :disabled="busy" @click="signIn()"> <ExternalIcon /> Sign in to Ely.by </Button>
+				<Button :disabled="busy || loading" @click="load()"> Refresh </Button>
+				<input
+					ref="fileInput"
+					type="file"
+					accept="image/png"
+					class="hidden"
+					@change="onFileChosen"
+				/>
+			</div>
+		</div>
+
+		<template #actions>
+			<div class="flex items-center justify-between gap-2">
+				<Button
+					:disabled="busy || !selectedSkin"
+					color="red"
+					type="outlined"
+					@click="removeSelected()"
+				>
+					<TrashIcon /> Remove from Ely.by
+				</Button>
+				<div class="flex gap-2">
+					<Button :disabled="busy" @click="modal?.hide()">Close</Button>
+					<Button
+						type="colored"
+						color="brand"
+						:disabled="busy || !selectedSkin || isCurrent(selectedSkin)"
+						:loading="busy"
+						@click="applySelected()"
+					>
+						<CheckIcon /> Apply
+					</Button>
+				</div>
+			</div>
+		</template>
+	</NewModal>
+</template>
+
+<script setup lang="ts">
+import { CheckIcon, ExternalIcon, SpinnerIcon, TrashIcon, UploadIcon } from '@modrinth/assets'
+import { Button, injectNotificationManager, NewModal } from '@modrinth/ui'
+import { computed, ref, useTemplateRef } from 'vue'
+
+import {
+	type ElyCatalogue,
+	type ElySkin,
+	getElyCatalogue,
+	getElyTexture,
+	openElyWindow,
+	removeElySkin,
+	uploadElySkin,
+	wearElySkin,
+} from '@/helpers/ely_skins'
+
+const props = defineProps<{ username: string }>()
+
+const { addNotification, handleError } = injectNotificationManager()
+
+const modal = useTemplateRef<InstanceType<typeof NewModal>>('modal')
+const fileInput = useTemplateRef<HTMLInputElement>('fileInput')
+
+const loading = ref(false)
+const busy = ref(false)
+const loadError = ref('')
+const catalogue = ref<ElyCatalogue | null>(null)
+const textures = ref<Record<string, string>>({})
+const selectedKey = ref<string | null>(null)
+
+const CURRENT_KEY = 'current'
+
+const sameUrl = (a?: string | null, b?: string | null) =>
+	!!a && !!b && a.replace(/^https?:/, '') === b.replace(/^https?:/, '')
+
+function isCurrent(skin: ElySkin | null | undefined) {
+	return !!skin && sameUrl(skin.skin_url, catalogue.value?.current_url)
+}
+
+/** The catalogue, plus a tile for the worn skin when it is not in it. */
+const tiles = computed(() => {
+	const data = catalogue.value
+	if (!data) return []
+	const list = data.skins.map((skin) => ({
+		key: String(skin.id),
+		url: skin.skin_url,
+		label: skin.is_slim ? 'Slim' : 'Classic',
+		current: isCurrent(skin),
+	}))
+	if (data.current_url && !data.skins.some((skin) => isCurrent(skin))) {
+		list.unshift({
+			key: CURRENT_KEY,
+			url: data.current_url,
+			label: 'Current',
+			current: true,
+		})
+	}
+	return list
+})
+
+const selectedSkin = computed(
+	() => catalogue.value?.skins.find((skin) => String(skin.id) === selectedKey.value) ?? null,
+)
+
+/** The face and hat layers of a skin texture, scaled up to a tile. */
+function headStyle(texture?: string) {
+	if (!texture) return {}
+	return {
+		backgroundImage: `url(${texture}), url(${texture})`,
+		backgroundPosition: '-64px -64px, -320px -64px',
+		backgroundSize: '512px auto, 512px auto',
+		backgroundRepeat: 'no-repeat',
+		imageRendering: 'pixelated' as const,
+	}
+}
+
+async function load() {
+	if (!props.username) return
+	loading.value = true
+	loadError.value = ''
+	try {
+		const data = await getElyCatalogue(props.username)
+		catalogue.value = data
+		const urls = new Set<string>(data.skins.map((skin) => skin.skin_url))
+		if (data.current_url) urls.add(data.current_url)
+		// Tiles fill in as textures arrive.
+		for (const url of urls) {
+			if (textures.value[url]) continue
+			getElyTexture(url)
+				.then((texture) => {
+					textures.value = { ...textures.value, [url]: texture }
+				})
+				.catch(() => {})
+		}
+		if (!tiles.value.some((tile) => tile.key === selectedKey.value)) selectedKey.value = null
+	} catch (error) {
+		loadError.value = error instanceof Error ? error.message : 'Could not load skins from Ely.by'
+	} finally {
+		loading.value = false
+	}
+}
+
+/** Ely.by's CDN can lag a moment behind a change; look again shortly after. */
+function reloadSoon() {
+	void load()
+	setTimeout(() => void load(), 3000)
+}
+
+async function signIn() {
+	try {
+		await openElyWindow()
+	} catch (error) {
+		handleError(error as Error)
+	}
+}
+
+async function applySelected() {
+	const skin = selectedSkin.value
+	if (!skin) return
+	busy.value = true
+	try {
+		await wearElySkin(props.username, skin.id)
+		addNotification({ type: 'success', title: 'Skin applied on Ely.by', text: '' })
+		reloadSoon()
+	} catch (error) {
+		handleError(error as Error)
+	} finally {
+		busy.value = false
+	}
+}
+
+async function removeSelected() {
+	const skin = selectedSkin.value
+	if (!skin) return
+	if (!window.confirm('Remove this skin from your Ely.by catalogue?')) return
+	busy.value = true
+	try {
+		await removeElySkin(props.username, skin.id)
+		selectedKey.value = null
+		reloadSoon()
+	} catch (error) {
+		handleError(error as Error)
+	} finally {
+		busy.value = false
+	}
+}
+
+function readAsDataUrl(file: File): Promise<string> {
+	return new Promise((resolve, reject) => {
+		const reader = new FileReader()
+		reader.onload = () => resolve(String(reader.result))
+		reader.onerror = () => reject(new Error('Could not read the file'))
+		reader.readAsDataURL(file)
+	})
+}
+
+async function onFileChosen(event: Event) {
+	const input = event.target as HTMLInputElement
+	const file = input.files?.[0]
+	input.value = ''
+	if (!file) return
+	if (file.type !== 'image/png') {
+		handleError(new Error('The skin must be a PNG file'))
+		return
+	}
+	if (file.size > 2 * 1024 * 1024) {
+		handleError(new Error('The skin file is too large'))
+		return
+	}
+	busy.value = true
+	try {
+		await uploadElySkin(props.username, await readAsDataUrl(file))
+		addNotification({ type: 'success', title: 'Skin uploaded to Ely.by', text: '' })
+		reloadSoon()
+	} catch (error) {
+		handleError(error as Error)
+	} finally {
+		busy.value = false
+	}
+}
+
+function show() {
+	selectedKey.value = null
+	modal.value?.show()
+	void load()
+}
+
+defineExpose({ show })
+</script>
