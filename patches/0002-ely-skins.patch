+<template>
+	<NewModal ref="modal" header="Ely.by skins" max-width="720px">
+		<div class="flex flex-col gap-6 md:flex-row">
+			<div class="h-[22rem] w-[14rem] min-w-[14rem] flex-shrink-0 md:self-center">
+				<SkinPreviewRenderer
+					v-if="previewTexture"
+					:variant="previewVariant"
+					:texture-src="previewTexture"
+					framing="modal"
+					:initial-rotation="Math.PI / 8"
+					class="h-full w-full"
+				/>
+				<div v-else class="flex h-full w-full items-center justify-center text-secondary">
+					<SpinnerIcon v-if="loading" class="animate-spin" />
+					<span v-else>No skin to preview</span>
+				</div>
+			</div>
+
+			<div class="flex w-full min-w-52 flex-col gap-4">
+				<p class="m-0 text-primary">
+					Offline accounts keep their skin on Ely.by, under the same username (<b>{{
+						username
+					}}</b
+					>). Preview and download your skins here. To add or change one, use the Ely.by website.
+				</p>
+				<p class="m-0 text-sm text-secondary">
+					Skins do not show in-game by themselves. For that, install the CustomSkinLoader mod and
+					enable its Ely.by skin source.
+				</p>
+
+				<p v-if="loadError" class="m-0 text-red">{{ loadError }}</p>
+				<p v-else-if="!loading && !tiles.length" class="m-0 text-secondary">
+					No skins found for {{ username }} on Ely.by.
+				</p>
+
+				<div
+					v-if="tiles.length"
+					class="grid max-h-56 grid-cols-[repeat(auto-fill,minmax(88px,1fr))] gap-3 overflow-y-auto"
+				>
+					<button
+						v-for="tile in tiles"
+						:key="tile.key"
+						type="button"
+						class="flex flex-col items-center gap-2 rounded-xl border-2 border-solid bg-surface-4 p-3 text-primary"
+						:class="selectedKey === tile.key ? 'border-brand' : 'border-transparent'"
+						@click="selectedKey = tile.key"
+					>
+						<div
+							class="h-14 w-14 rounded-lg bg-surface-5"
+							:style="headStyle(textures[tile.url])"
+							role="img"
+							:aria-label="tile.label"
+						/>
+						<span class="text-xs">{{ tile.label }}</span>
+						<span v-if="tile.current" class="text-xs font-semibold text-brand">In use</span>
+					</button>
+				</div>
+
+				<div class="flex flex-wrap gap-2">
+					<Button @click="openSite()"> <ExternalIcon /> Open Ely.by </Button>
+					<Button :disabled="loading" @click="load()"> Refresh </Button>
+				</div>
+			</div>
+		</div>
+
+		<template #actions>
+			<div class="flex justify-end gap-2">
+				<Button @click="modal?.hide()">Close</Button>
+				<Button
+					type="colored"
+					color="brand"
+					:disabled="!selectedTile || !textures[selectedTile.url] || saving"
+					:loading="saving"
+					@click="download()"
+				>
+					<DownloadIcon /> Download skin
+				</Button>
+			</div>
+		</template>
+	</NewModal>
+</template>
+
+<script setup lang="ts">
+import { DownloadIcon, ExternalIcon, SpinnerIcon } from '@modrinth/assets'
+import { Button, injectNotificationManager, NewModal, SkinPreviewRenderer } from '@modrinth/ui'
+import { save } from '@tauri-apps/plugin-dialog'
+import { computed, ref, useTemplateRef } from 'vue'
+
+import {
+	downloadElySkin,
+	type ElyCatalogue,
+	type ElySkin,
+	getElyCatalogue,
+	getElyTexture,
+	openElySite,
+} from '@/helpers/ely_skins'
+
+const props = defineProps<{ username: string }>()
+
+const { addNotification, handleError } = injectNotificationManager()
+
+const modal = useTemplateRef<InstanceType<typeof NewModal>>('modal')
+
+const loading = ref(false)
+const saving = ref(false)
+const loadError = ref('')
+const catalogue = ref<ElyCatalogue | null>(null)
+const textures = ref<Record<string, string>>({})
+const selectedKey = ref<string | null>(null)
+
+const CURRENT_KEY = 'current'
+
+const sameUrl = (a?: string | null, b?: string | null) =>
+	!!a && !!b && a.replace(/^https?:/, '') === b.replace(/^https?:/, '')
+
+function isCurrent(skin: ElySkin) {
+	return sameUrl(skin.skin_url, catalogue.value?.current_url)
+}
+
+/** The catalogue, plus a tile for the skin in use when it is not in it. */
+const tiles = computed(() => {
+	const data = catalogue.value
+	if (!data) return []
+	const list = data.skins.map((skin) => ({
+		key: String(skin.id),
+		url: skin.skin_url,
+		label: skin.is_slim ? 'Slim' : 'Classic',
+		slim: skin.is_slim,
+		current: isCurrent(skin),
+	}))
+	if (data.current_url && !data.skins.some((skin) => isCurrent(skin))) {
+		list.unshift({
+			key: CURRENT_KEY,
+			url: data.current_url,
+			label: 'Current',
+			slim: false,
+			current: true,
+		})
+	}
+	return list
+})
+
+const selectedTile = computed(() => tiles.value.find((tile) => tile.key === selectedKey.value))
+const previewTexture = computed(() =>
+	selectedTile.value ? (textures.value[selectedTile.value.url] ?? '') : '',
+)
+const previewVariant = computed(() => (selectedTile.value?.slim ? 'SLIM' : 'CLASSIC'))
+
+/** The face and hat layers of a skin texture, scaled up to a tile. */
+function headStyle(texture?: string) {
+	if (!texture) return {}
+	return {
+		backgroundImage: `url(${texture}), url(${texture})`,
+		backgroundPosition: '-56px -56px, -280px -56px',
+		backgroundSize: '448px auto, 448px auto',
+		backgroundRepeat: 'no-repeat',
+		imageRendering: 'pixelated' as const,
+	}
+}
+
+async function load() {
+	if (!props.username) return
+	loading.value = true
+	loadError.value = ''
+	try {
+		const data = await getElyCatalogue(props.username)
+		catalogue.value = data
+		const urls = new Set<string>(data.skins.map((skin) => skin.skin_url))
+		if (data.current_url) urls.add(data.current_url)
+		// Tiles and the preview fill in as textures arrive.
+		for (const url of urls) {
+			if (textures.value[url]) continue
+			getElyTexture(url)
+				.then((texture) => {
+					textures.value = { ...textures.value, [url]: texture }
+				})
+				.catch(() => {})
+		}
+		if (!tiles.value.some((tile) => tile.key === selectedKey.value)) {
+			selectedKey.value = (tiles.value.find((tile) => tile.current) ?? tiles.value[0])?.key ?? null
+		}
+	} catch (error) {
+		loadError.value = error instanceof Error ? error.message : 'Could not load skins from Ely.by'
+	} finally {
+		loading.value = false
+	}
+}
+
+async function openSite() {
+	try {
+		await openElySite()
+	} catch (error) {
+		handleError(error as Error)
+	}
+}
+
+async function download() {
+	const tile = selectedTile.value
+	if (!tile) return
+	saving.value = true
+	try {
+		const path = await save({
+			title: 'Save skin',
+			defaultPath: `${props.username}-skin.png`,
+			filters: [{ name: 'PNG image', extensions: ['png'] }],
+		})
+		if (!path) return
+		await downloadElySkin(tile.url, path)
+		addNotification({ type: 'success', title: 'Skin saved', text: path })
+	} catch (error) {
+		handleError(error as Error)
+	} finally {
+		saving.value = false
+	}
+}
+
+function show() {
+	selectedKey.value = null
+	modal.value?.show()
+	void load()
+}
+
+defineExpose({ show })
+</script>
