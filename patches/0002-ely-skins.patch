+/**
+ * Ely.by skin helpers for offline accounts (read-only).
+ *
+ * Offline accounts keep their skin on Ely.by under the same username. Skins
+ * can be previewed and downloaded here; changing one is done on the Ely.by
+ * website, opened in the default browser.
+ */
+import { invoke } from '@tauri-apps/api/core'
+
+/** A skin in an account's Ely.by catalogue. */
+export interface ElySkin {
+	id: number
+	skin_url: string
+	is_slim: boolean
+}
+
+export interface ElyCatalogue {
+	/** URL of the skin Ely.by currently serves for the username. */
+	current_url: string | null
+	skins: ElySkin[]
+}
+
+export async function getElyCatalogue(username: string): Promise<ElyCatalogue> {
+	return await invoke('plugin:auth|ely_skin_catalogue', { username })
+}
+
+/** A skin texture as a data: URL (Ely.by sends no CORS headers). */
+export async function getElyTexture(url: string): Promise<string> {
+	return await invoke('plugin:auth|ely_texture', { url })
+}
+
+/** Saves a skin texture to `path`. */
+export async function downloadElySkin(url: string, path: string): Promise<void> {
+	await invoke('plugin:auth|ely_download_skin', { url, path })
+}
+
+/** Opens the Ely.by skins page in the default browser. */
+export async function openElySite(): Promise<void> {
+	await invoke('plugin:auth|ely_open_site')
+}
