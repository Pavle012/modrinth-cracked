+/**
+ * Ely.by skin helpers for offline accounts.
+ *
+ * Offline accounts keep their skin on Ely.by under the same username. Reading
+ * is public; changes run through the Ely.by website in an embedded window
+ * (Ely.by has no skin API), so the player signs in there once.
+ */
+import { invoke } from '@tauri-apps/api/core'
+
+/** A skin in an account's Ely.by catalogue. */
+export interface ElySkin {
+	id: number
+	skin_url: string
+	is_slim: boolean
+}
+
+export interface ElyCatalogue {
+	/** URL of the skin Ely.by currently serves for the username. */
+	current_url: string | null
+	skins: ElySkin[]
+}
+
+export async function getElyCatalogue(username: string): Promise<ElyCatalogue> {
+	return await invoke('plugin:auth|ely_skin_catalogue', { username })
+}
+
+/** A skin texture as a data: URL (Ely.by sends no CORS headers). */
+export async function getElyTexture(url: string): Promise<string> {
+	return await invoke('plugin:auth|ely_texture', { url })
+}
+
+/** Opens the embedded Ely.by window so the player can sign in. */
+export async function openElyWindow(): Promise<void> {
+	await invoke('plugin:auth|ely_open_window')
+}
+
+export async function wearElySkin(username: string, skinId: number): Promise<void> {
+	await invoke('plugin:auth|ely_wear_skin', { username, skinId })
+}
+
+export async function removeElySkin(username: string, skinId: number): Promise<void> {
+	await invoke('plugin:auth|ely_remove_skin', { username, skinId })
+}
+
+/** Uploads a PNG (as a data: URL) to the catalogue and wears it. */
+export async function uploadElySkin(username: string, dataUrl: string): Promise<void> {
+	await invoke('plugin:auth|ely_upload_skin', { username, dataUrl })
+}
