@@ -0,0 +1,447 @@
+//! Ely.by skin management for offline accounts.
+//!
+//! Offline accounts have no Mojang profile, so their skin lives on Ely.by
+//! under the same username. Ely.by has no skin API: reading is public
+//! (the skin system and the website's catalogue listing), but changing a
+//! skin goes through the website itself. Writes therefore run inside an
+//! embedded window where the player signs in to ely.by once; no Ely.by
+//! password ever passes through the launcher.
+
+use crate::api::Result;
+use base64::Engine;
+use serde::{Deserialize, Serialize};
+use std::sync::{LazyLock, Mutex};
+use std::time::{Duration, Instant};
+use tauri::{AppHandle, Manager, Runtime, WebviewWindow};
+use tauri_plugin_http::reqwest;
+
+/// Label of the embedded Ely.by window.
+const WINDOW_LABEL: &str = "ely-skins";
+const WINDOW_URL: &str = "https://ely.by/skins/add";
+
+/// How long a website call has to answer before it is given up on.
+const CALL_TIMEOUT: Duration = Duration::from_secs(30);
+
+/// Largest texture the launcher will pull through [`ely_texture`].
+const MAX_TEXTURE_BYTES: usize = 2 * 1024 * 1024;
+
+static CLIENT: LazyLock<reqwest::Client> = LazyLock::new(|| {
+    reqwest::Client::builder()
+        .connect_timeout(Duration::from_secs(15))
+        .timeout(Duration::from_secs(30))
+        .user_agent("modrinth-app-offline-patch")
+        .build()
+        .expect("client configuration should be valid")
+});
+
+/// A script waiting for the embedded window to arrive on ely.by.
+static PENDING_SCRIPT: Mutex<Option<String>> = Mutex::new(None);
+
+/// One skin in an account's Ely.by catalogue.
+#[derive(Serialize, Deserialize, Debug, Clone)]
+pub struct ElySkin {
+    /// Catalogue ID, which is also what wearing a skin takes.
+    pub id: u64,
+    pub skin_url: String,
+    /// Whether the skin uses the three-pixel-arm model.
+    #[serde(default)]
+    pub is_slim: bool,
+}
+
+#[derive(Deserialize)]
+struct ElySkinListing {
+    items: Vec<ElySkin>,
+}
+
+#[derive(Serialize, Debug)]
+pub struct ElyCatalogue {
+    /// URL of the skin the skin system currently serves for the username.
+    pub current_url: Option<String>,
+    pub skins: Vec<ElySkin>,
+}
+
+#[derive(Deserialize)]
+struct ElyTexture {
+    url: String,
+}
+
+#[derive(Deserialize)]
+struct ElyTextures {
+    #[serde(rename = "SKIN")]
+    skin: Option<ElyTexture>,
+}
+
+fn error(message: impl Into<String>) -> crate::api::CommandError {
+    anyhow::anyhow!(message.into()).into()
+}
+
+/// Sends a request, and once more if it did not get through. Ely.by drops
+/// connections or answers 5xx often enough that one retry smooths it over.
+async fn send(
+    request: impl Fn() -> reqwest::RequestBuilder,
+) -> std::result::Result<reqwest::Response, reqwest::Error> {
+    match request().send().await {
+        Ok(response) if !response.status().is_server_error() => Ok(response),
+        _ => {
+            tokio::time::sleep(Duration::from_millis(400)).await;
+            request().send().await
+        }
+    }
+}
+
+/// The skins `username` has uploaded to Ely.by, and the one currently worn.
+#[tauri::command]
+pub async fn ely_skin_catalogue(username: String) -> Result<ElyCatalogue> {
+    let name = urlencoding::encode(&username).into_owned();
+
+    let listing_url =
+        format!("https://ely.by/api/legacy/skins?uploader={name}");
+    let response = send(|| {
+        CLIENT
+            .get(&listing_url)
+            .header("X-Requested-With", "XMLHttpRequest")
+            .header("Accept", "application/json")
+    })
+    .await
+    .map_err(|e| error(format!("Could not reach Ely.by: {e}")))?;
+    if !response.status().is_success() {
+        return Err(error(format!(
+            "Ely.by skin listing failed (HTTP {})",
+            response.status()
+        )));
+    }
+    let body = response.bytes().await.map_err(|e| {
+        error(format!("Could not read the Ely.by listing: {e}"))
+    })?;
+    let listing: ElySkinListing = serde_json::from_slice(&body)
+        .map_err(|e| error(format!("Unexpected Ely.by listing format: {e}")))?;
+
+    // The timestamp keeps a CDN from serving the skin from before a change.
+    let textures_url = format!(
+        "https://skinsystem.ely.by/textures/{name}?_={}",
+        chrono::Utc::now().timestamp_millis()
+    );
+    let current_url = match send(|| CLIENT.get(&textures_url)).await {
+        Ok(response) if response.status().is_success() => response
+            .bytes()
+            .await
+            .ok()
+            .and_then(|body| serde_json::from_slice::<ElyTextures>(&body).ok())
+            .and_then(|textures| textures.skin)
+            .map(|skin| skin.url),
+        _ => None,
+    };
+
+    Ok(ElyCatalogue {
+        current_url,
+        skins: listing.items,
+    })
+}
+
+/// Fetches a skin texture as a `data:` URL. The frontend cannot load these
+/// itself: Ely.by serves some over plain http and sends no CORS headers.
+/// Restricted to Ely.by and Mojang texture hosts so it is not a general proxy.
+#[tauri::command]
+pub async fn ely_texture(url: String) -> Result<String> {
+    let parsed = reqwest::Url::parse(&url)
+        .map_err(|e| error(format!("Not a texture URL: {e}")))?;
+    let host = parsed.host_str().unwrap_or_default();
+    let allowed = host == "ely.by"
+        || host.ends_with(".ely.by")
+        || host == "textures.minecraft.net";
+    if !allowed || !matches!(parsed.scheme(), "http" | "https") {
+        return Err(error(format!("Refusing to fetch a texture from {host}")));
+    }
+
+    let response = send(|| CLIENT.get(parsed.clone()))
+        .await
+        .map_err(|e| error(format!("Could not fetch the texture: {e}")))?;
+    if !response.status().is_success() {
+        return Err(error(format!(
+            "Texture not available (HTTP {})",
+            response.status()
+        )));
+    }
+    let bytes = response
+        .bytes()
+        .await
+        .map_err(|e| error(format!("Could not read the texture: {e}")))?;
+    if bytes.len() > MAX_TEXTURE_BYTES {
+        return Err(error("The texture is too large"));
+    }
+
+    Ok(format!(
+        "data:image/png;base64,{}",
+        base64::engine::general_purpose::STANDARD.encode(&bytes)
+    ))
+}
+
+fn parse_window_url() -> tauri::Url {
+    WINDOW_URL.parse().expect("static Ely.by URL must parse")
+}
+
+/// Opens (or focuses) the embedded Ely.by window so the player can sign in.
+#[tauri::command]
+pub async fn ely_open_window<R: Runtime>(app: AppHandle<R>) -> Result<()> {
+    show_window(&app)
+}
+
+fn show_window<R: Runtime>(app: &AppHandle<R>) -> Result<()> {
+    if let Some(window) = app.get_webview_window(WINDOW_LABEL) {
+        window
+            .eval("window.location.assign('https://ely.by/skins/add')")
+            .ok();
+        window.show().ok();
+        window.set_focus().ok();
+        return Ok(());
+    }
+
+    build_window(app, true)?;
+    Ok(())
+}
+
+fn build_window<R: Runtime>(
+    app: &AppHandle<R>,
+    visible: bool,
+) -> Result<WebviewWindow<R>> {
+    Ok(tauri::WebviewWindowBuilder::new(
+        app,
+        WINDOW_LABEL,
+        tauri::WebviewUrl::External(parse_window_url()),
+    )
+    .title("Ely.by")
+    .inner_size(1080.0, 800.0)
+    .center()
+    .visible(visible)
+    .on_page_load(|window, payload| {
+        // Run the waiting script once the page is really there; run as it
+        // starts, it would hit the blank document before it.
+        if payload.event() == tauri::webview::PageLoadEvent::Finished
+            && payload.url().host_str() == Some("ely.by")
+        {
+            let script = PENDING_SCRIPT.lock().ok().and_then(|mut p| p.take());
+            if let Some(script) = script {
+                window.eval(&script).ok();
+            }
+        }
+    })
+    .build()?)
+}
+
+/// Runs `script` in the embedded window once it is on ely.by (a fetch from
+/// any other origin would not carry the site session).
+fn run_in_window<R: Runtime>(app: &AppHandle<R>, script: String) -> Result<()> {
+    if let Some(window) = app.get_webview_window(WINDOW_LABEL) {
+        let on_ely = window
+            .url()
+            .map(|url| url.host_str() == Some("ely.by"))
+            .unwrap_or(false);
+        if on_ely {
+            window.eval(&script).ok();
+        } else {
+            if let Ok(mut pending) = PENDING_SCRIPT.lock() {
+                *pending = Some(script);
+            }
+            window
+                .eval("window.location.assign('https://ely.by/skins/add')")
+                .ok();
+        }
+        return Ok(());
+    }
+
+    if let Ok(mut pending) = PENDING_SCRIPT.lock() {
+        *pending = Some(script);
+    }
+    build_window(app, false)?;
+    Ok(())
+}
+
+/// Wrapper run in the window: checks who the site is signed in as, runs the
+/// call only for `username`, and reports back through the address fragment
+/// (a window on a remote origin has no other way out).
+const WRAPPER_SCRIPT: &str = r#"(async function () {
+    const report = function (result) { location.hash = 'ely-skins-%TOKEN%-' + result; };
+    try {
+        const page = await fetch('https://ely.by/', { credentials: 'same-origin' }).then(function (r) { return r.text(); });
+        const found = page.match(/alight\.service\.currentUser\s*=\s*(\{[\s\S]*?\});/);
+        const user = found ? JSON.parse(found[1]) : null;
+        if (!user || !user.id || user.status === 'guest') return report('guest');
+        if (String(user.nickname).toLowerCase() !== %EXPECTED%.toLowerCase()) {
+            return report('other-' + encodeURIComponent(user.nickname));
+        }
+        const ok = await (%CALL%);
+        report(ok ? 'done' : 'failed');
+    } catch (e) {
+        report('failed');
+    }
+})();"#;
+
+const WEAR_CALL: &str = r#"fetch('https://ely.by/api/legacy/users/skin', {
+    method: 'PUT',
+    credentials: 'same-origin',
+    headers: {
+        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
+        'X-Requested-With': 'XMLHttpRequest'
+    },
+    body: 'skinId=%ID%'
+}).then(function (r) { return r.ok; })"#;
+
+const REMOVE_CALL: &str = r#"fetch('https://ely.by/api/legacy/skins/%ID%', {
+    method: 'DELETE',
+    credentials: 'same-origin',
+    headers: { 'X-Requested-With': 'XMLHttpRequest' }
+}).then(function (r) { return r.ok; })"#;
+
+const UPLOAD_CALL: &str = r#"(async function () {
+    const blob = await (await fetch('%DATA_URL%')).blob();
+    const form = new FormData();
+    form.append('file', new File([blob], 'skin.png', { type: 'image/png' }));
+    const uploaded = await fetch('https://ely.by/api/legacy/skins', {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'X-Requested-With': 'XMLHttpRequest' },
+        body: form
+    });
+    if (!uploaded.ok) return false;
+    const data = await uploaded.json();
+    const match = String(data.url || '').match(/\/skins\/s(\d+)/);
+    if (!match) return false;
+    const worn = await fetch('https://ely.by/api/legacy/users/skin', {
+        method: 'PUT',
+        credentials: 'same-origin',
+        headers: {
+            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
+            'X-Requested-With': 'XMLHttpRequest'
+        },
+        body: 'skinId=' + match[1]
+    });
+    return worn.ok;
+})()"#;
+
+/// Runs a website call as `username`, and only as them.
+async fn run_as_account<R: Runtime>(
+    app: AppHandle<R>,
+    username: &str,
+    call: String,
+) -> Result<()> {
+    let token = uuid::Uuid::new_v4().simple().to_string();
+    let expected = serde_json::to_string(username)
+        .map_err(|e| error(format!("Invalid username: {e}")))?;
+    let script = WRAPPER_SCRIPT
+        .replace("%TOKEN%", &token)
+        .replace("%EXPECTED%", &expected)
+        .replace("%CALL%", &call);
+
+    run_in_window(&app, script)?;
+
+    let marker = format!("ely-skins-{token}-");
+    let started = Instant::now();
+    let answer = loop {
+        let Some(window) = app.get_webview_window(WINDOW_LABEL) else {
+            return Err(error(
+                "The Ely.by window was closed before it answered.",
+            ));
+        };
+        let fragment = window
+            .url()
+            .ok()
+            .and_then(|url| url.fragment().map(str::to_string));
+        if let Some(answer) =
+            fragment.and_then(|f| f.strip_prefix(&marker).map(str::to_string))
+        {
+            break answer;
+        }
+        if started.elapsed() > CALL_TIMEOUT {
+            // Leave a window the player cannot see from lingering.
+            if !window.is_visible().unwrap_or(false) {
+                window.close().ok();
+            }
+            return Err(error("Ely.by did not answer. Try again in a moment."));
+        }
+        tokio::time::sleep(Duration::from_millis(100)).await;
+    };
+
+    // A window opened only for this call is closed again; one the player
+    // is looking at (signing in) is left alone.
+    if let Some(window) = app.get_webview_window(WINDOW_LABEL)
+        && !window.is_visible().unwrap_or(false)
+    {
+        window.close().ok();
+    }
+
+    match answer.as_str() {
+        "done" => Ok(()),
+        "guest" => {
+            show_window(&app)?;
+            Err(error(format!(
+                "You are not signed in to Ely.by. Sign in as {username} in the window that opened, close it, then try again."
+            )))
+        }
+        other if other.starts_with("other-") => {
+            let signed_in = urlencoding::decode(&other["other-".len()..])
+                .map(|name| name.into_owned())
+                .unwrap_or_default();
+            show_window(&app)?;
+            Err(error(format!(
+                "Ely.by is signed in as {signed_in}, not {username}, so nothing was changed. Sign out there, sign in as {username}, close the window, then try again."
+            )))
+        }
+        _ => Err(error("Ely.by did not accept the change.")),
+    }
+}
+
+/// Puts one of the account's catalogue skins on.
+#[tauri::command]
+pub async fn ely_wear_skin<R: Runtime>(
+    app: AppHandle<R>,
+    username: String,
+    skin_id: u64,
+) -> Result<()> {
+    run_as_account(
+        app,
+        &username,
+        WEAR_CALL.replace("%ID%", &skin_id.to_string()),
+    )
+    .await
+}
+
+/// Removes one of the account's skins from the Ely.by catalogue.
+#[tauri::command]
+pub async fn ely_remove_skin<R: Runtime>(
+    app: AppHandle<R>,
+    username: String,
+    skin_id: u64,
+) -> Result<()> {
+    run_as_account(
+        app,
+        &username,
+        REMOVE_CALL.replace("%ID%", &skin_id.to_string()),
+    )
+    .await
+}
+
+/// Uploads a PNG (as a `data:` URL) to the account's catalogue and wears it.
+#[tauri::command]
+pub async fn ely_upload_skin<R: Runtime>(
+    app: AppHandle<R>,
+    username: String,
+    data_url: String,
+) -> Result<()> {
+    // The value is placed inside a script, so only plain base64 PNG data
+    // is accepted.
+    let payload = data_url
+        .strip_prefix("data:image/png;base64,")
+        .filter(|data| {
+            !data.is_empty()
+                && data.bytes().all(|b| {
+                    b.is_ascii_alphanumeric() || matches!(b, b'+' | b'/' | b'=')
+                })
+        })
+        .ok_or_else(|| error("The skin must be a PNG file"))?;
+    if payload.len() > MAX_TEXTURE_BYTES * 4 / 3 {
+        return Err(error("The skin file is too large"));
+    }
+
+    run_as_account(app, &username, UPLOAD_CALL.replace("%DATA_URL%", &data_url))
+        .await
+}
