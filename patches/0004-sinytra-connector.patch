+    fn multi_loader_request(
+        project_id: &str,
+        loaders: &[&str],
+    ) -> ResolveContentRequest {
+        let mut request = request(project_id);
+        request.target = ResolutionPreferences {
+            game_versions: vec!["1.20.1".to_string()],
+            loaders: loaders.iter().map(|loader| loader.to_string()).collect(),
+        };
+        request
+    }
+
+    #[tokio::test]
+    async fn earlier_loader_wins_over_newer_version_of_later_loader() {
+        let provider = MemoryProvider::default().with_versions(vec![
+            version(
+                "neoforge-old",
+                "p1",
+                "2024-01-01T00:00:00Z",
+                &["1.20.1"],
+                &["neoforge"],
+                vec![],
+            ),
+            version(
+                "fabric-new",
+                "p1",
+                "2024-06-01T00:00:00Z",
+                &["1.20.1"],
+                &["fabric"],
+                vec![],
+            ),
+        ]);
+
+        let plan = resolve_content(
+            provider,
+            multi_loader_request("p1", &["neoforge", "fabric"]),
+        )
+        .await
+        .unwrap();
+
+        assert_eq!(plan.primary.version_id, "neoforge-old");
+    }
+
+    #[tokio::test]
+    async fn later_loader_is_used_when_the_earlier_one_has_no_version() {
+        let provider = MemoryProvider::default().with_versions(vec![version(
+            "fabric-only",
+            "p1",
+            "2024-06-01T00:00:00Z",
+            &["1.20.1"],
+            &["fabric"],
+            vec![],
+        )]);
+
+        let plan = resolve_content(
+            provider,
+            multi_loader_request("p1", &["neoforge", "fabric"]),
+        )
+        .await
+        .unwrap();
+
+        assert_eq!(plan.primary.version_id, "fabric-only");
+    }
+
+    #[tokio::test]
+    async fn dependencies_prefer_the_earlier_loader_too() {
+        let provider = MemoryProvider::default().with_versions(vec![
+            version(
+                "mod-fabric",
+                "p1",
+                "2024-06-01T00:00:00Z",
+                &["1.20.1"],
+                &["fabric"],
+                vec![required_project_dependency("lib")],
+            ),
+            version(
+                "lib-neoforge",
+                "lib",
+                "2024-01-01T00:00:00Z",
+                &["1.20.1"],
+                &["neoforge"],
+                vec![],
+            ),
+            version(
+                "lib-fabric",
+                "lib",
+                "2024-06-01T00:00:00Z",
+                &["1.20.1"],
+                &["fabric"],
+                vec![],
+            ),
+        ]);
+
+        let plan = resolve_content(
+            provider,
+            multi_loader_request("p1", &["neoforge", "fabric"]),
+        )
+        .await
+        .unwrap();
+
+        assert_eq!(plan.primary.version_id, "mod-fabric");
+        assert_eq!(plan.dependencies.len(), 1);
+        assert_eq!(plan.dependencies[0].version_id, "lib-neoforge");
+    }
 }
