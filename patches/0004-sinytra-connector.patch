+/**
+ * Sinytra Connector support.
+ *
+ * Connector lets Fabric mods run on (Neo)Forge. On an instance that has it
+ * installed, Fabric mods count as compatible alongside the instance's own
+ * loader, but always as a fallback: a version for the instance's own loader is
+ * preferred over a Fabric one.
+ */
+import { get_installed_project_ids } from '@/helpers/instance'
+
+/** Modrinth project ID of Sinytra Connector. */
+export const SINYTRA_CONNECTOR_PROJECT_ID = 'u58R1TMW'
+
+const CONNECTOR_LOADERS = new Set(['neoforge', 'forge'])
+
+/** Loaders to allow besides the instance's own, given the project IDs installed in it. */
+export function connectorExtraLoaders(
+	loader: string,
+	installedProjectIds: readonly string[] | null | undefined,
+): string[] {
+	return CONNECTOR_LOADERS.has(loader) && installedProjectIds?.includes(SINYTRA_CONNECTOR_PROJECT_ID)
+		? ['fabric']
+		: []
+}
+
+/** Same, given an instance's content files as returned by `get_projects`. */
+export function connectorExtraLoadersFromFiles(
+	loader: string,
+	files: Record<string, { metadata?: { project_id?: string } | null }> | null | undefined,
+): string[] {
+	if (!files) return []
+	return connectorExtraLoaders(
+		loader,
+		Object.values(files).map((file) => file.metadata?.project_id ?? ''),
+	)
+}
+
+/** Same, looking the installed project IDs up for an instance. */
+export async function getConnectorExtraLoaders(
+	instanceId: string,
+	loader: string,
+): Promise<string[]> {
+	if (!CONNECTOR_LOADERS.has(loader)) return []
+	try {
+		return connectorExtraLoaders(loader, await get_installed_project_ids(instanceId))
+	} catch {
+		return []
+	}
+}
