+/// Sinytra Connector, which lets Fabric mods run on (Neo)Forge.
+const SINYTRA_CONNECTOR_PROJECT_ID: &str = "u58R1TMW";
+/// Fabric API. With Connector it is provided by Forgified Fabric API, and the
+/// real one would clash with it.
+const FABRIC_API_PROJECT_ID: &str = "P7dR8mSH";
+
+/// Whether the instance can run Fabric mods: a (Neo)Forge instance with
+/// Sinytra Connector installed.
+fn fabric_mods_allowed(
+    loader: ModLoader,
+    content_type: ContentType,
+    existing_project_ids: &[String],
+) -> bool {
+    content_type == ContentType::Mod
+        && matches!(loader, ModLoader::NeoForge | ModLoader::Forge)
+        && existing_project_ids
+            .iter()
+            .any(|id| id == SINYTRA_CONNECTOR_PROJECT_ID)
+}
