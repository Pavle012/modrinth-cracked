-            matches(version, target)
+    // Loaders are listed in order of preference, so a version for an earlier
+    // loader wins over a newer version for a later one.
+    let newest_by_loader_preference = |preferences: &ResolutionPreferences| {
+        loader_tiers(preferences).iter().find_map(|tier| {
+            newest_in_channel(&versions, update_channel, |version| {
+                matches(version, tier)
+            })
         })
-    })
-    .cloned()
+    };
+
+    newest_by_loader_preference(&merged)
+        .or_else(|| newest_by_loader_preference(target))
+        .cloned()
+}
+
+/// Splits preferences listing several loaders into one set of preferences per
+/// loader, in order. Preferences with fewer than two loaders stay as they are.
+fn loader_tiers(
+    preferences: &ResolutionPreferences,
+) -> Vec<ResolutionPreferences> {
+    if preferences.loaders.len() < 2 {
+        return vec![preferences.clone()];
+    }
+
+    preferences
+        .loaders
+        .iter()
+        .map(|loader| ResolutionPreferences {
+            game_versions: preferences.game_versions.clone(),
+            loaders: vec![loader.clone()],
+        })
+        .collect()
 }
 
 /// Finds the newest matching version within the update channel, widening the channel one step at
