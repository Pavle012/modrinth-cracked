+#[cfg(test)]
+mod tests {
+    use super::is_line_ending_only_checksum;
+    use sha2::{Digest, Sha384};
+    use sqlx::migrate::{Migration, MigrationType};
+    use sqlx::SqlSafeStr;
+
+    #[test]
+    fn accepts_only_line_ending_checksum_changes() {
+        let migration = Migration::new(
+            1,
+            "test".into(),
+            MigrationType::Simple,
+            "CREATE TABLE test (\n    id INTEGER\n);\n".into_sql_str(),
+            false,
+        );
+        let crlf_checksum = Sha384::digest(
+            "CREATE TABLE test (\r\n    id INTEGER\r\n);\r\n".as_bytes(),
+        );
+        let edited_checksum =
+            Sha384::digest("CREATE TABLE changed (id INTEGER);\n".as_bytes());
+
+        assert!(is_line_ending_only_checksum(
+            &migration,
+            crlf_checksum.as_slice()
+        ));
+        assert!(!is_line_ending_only_checksum(
+            &migration,
+            edited_checksum.as_slice()
+        ));
+    }
+}
