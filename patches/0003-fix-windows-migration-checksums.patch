+async fn repair_line_ending_migration_checksums(
+    pool: &Pool<Sqlite>,
+    migrator: &Migrator,
+) -> crate::Result<()> {
+    let mut tx = pool.begin_with("BEGIN IMMEDIATE").await?;
+    let has_migrations_table = sqlx::query_scalar::<_, i64>(
+        "SELECT COUNT(*) FROM sqlite_master WHERE type = 'table' AND name = '_sqlx_migrations'",
+    )
+    .fetch_one(&mut *tx)
+    .await?
+        > 0;
+
+    if !has_migrations_table {
+        tx.commit().await?;
+        return Ok(());
+    }
+
+    let applied_migrations =
+        sqlx::query("SELECT version, checksum FROM _sqlx_migrations")
+            .fetch_all(&mut *tx)
+            .await?;
+
+    for applied in applied_migrations {
+        let version: i64 = applied.try_get("version")?;
+        let checksum: Vec<u8> = applied.try_get("checksum")?;
+        let Some(migration) = migrator.iter().find(|migration| {
+            migration.version == version
+                && migration.migration_type.is_up_migration()
+        }) else {
+            continue;
+        };
+
+        if !is_line_ending_only_checksum(migration, &checksum) {
+            continue;
+        }
+
+        sqlx::query(
+            "UPDATE _sqlx_migrations SET checksum = ? WHERE version = ?",
+        )
+        .bind(migration.checksum.as_ref())
+        .bind(version)
+        .execute(&mut *tx)
+        .await?;
+        tracing::info!(
+            "Repaired line-ending-only checksum mismatch for database migration {version}"
+        );
+    }
+
+    tx.commit().await?;
+    Ok(())
+}
+
+fn is_line_ending_only_checksum(
+    migration: &Migration,
+    applied_checksum: &[u8],
+) -> bool {
+    if applied_checksum == migration.checksum.as_ref() {
+        return false;
+    }
+
+    let lf_sql = migration.sql.as_str().replace("\r\n", "\n");
+    let lf_checksum = Sha384::digest(lf_sql.as_bytes());
+    if applied_checksum == lf_checksum.as_slice() {
+        return true;
+    }
+
+    let crlf_sql = lf_sql.replace('\n', "\r\n");
+    let crlf_checksum = Sha384::digest(crlf_sql.as_bytes());
+    applied_checksum == crlf_checksum.as_slice()
+}
